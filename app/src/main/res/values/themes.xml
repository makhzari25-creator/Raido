<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#2563EB</item>
        <item name="colorPrimaryVariant">#1D4ED8</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#16A34A</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#80000000</item>
        <item name="android:windowBackground">@drawable/bg_pages</item>
        <item name="android:fontFamily">@font/iransans</item>
        <item name="fontFamily">@font/iransans</item>
        <item name="android:textViewStyle">@style/RaidoTextView</item>
        <item name="buttonStyle">@style/RaidoButton</item>
        <item name="editTextStyle">@style/RaidoEditText</item>
    </style>

    <style name="RaidoTextView" parent="Widget.MaterialComponents.TextView">
        <item name="android:fontFamily">@font/iransans</item>
        <item name="fontFamily">@font/iransans</item>
    </style>

    <style name="RaidoButton" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/iransans</item>
        <item name="fontFamily">@font/iransans</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="RaidoEditText" parent="Widget.AppCompat.EditText">
        <item name="android:fontFamily">@font/iransans</item>
        <item name="fontFamily">@font/iransans</item>
    </style>

    <style name="SplashTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
